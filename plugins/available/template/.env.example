# Plugin Environment Variables Template
# Copy this to .env in your plugin directory and customize

# Plugin Basic Configuration
PLUGIN_NAME=your-plugin
PLUGIN_SUBDOMAIN=your-plugin  # Will create your-plugin.yourdomain.com
PLUGIN_PORT=8080

# Plugin-Specific Configuration
PLUGIN_ADMIN_USERNAME=admin
PLUGIN_ADMIN_PASSWORD=change-this-secure-password
PLUGIN_ADMIN_EMAIL=admin@yourdomain.com

# Database Configuration (if your plugin uses a database)
PLUGIN_DB_TYPE=postgresql  # postgresql, mysql, sqlite
PLUGIN_DB_HOST=your-service-db
PLUGIN_DB_PORT=5432
PLUGIN_DB_NAME=plugin_db
PLUGIN_DB_USER=plugin_user
PLUGIN_DB_PASSWORD=secure-database-password

# Redis Configuration (if your plugin uses Redis)
PLUGIN_REDIS_HOST=your-service-cache
PLUGIN_REDIS_PORT=6379
PLUGIN_REDIS_PASSWORD=secure-redis-password

# Application Settings
PLUGIN_LOG_LEVEL=INFO  # DEBUG, INFO, WARN, ERROR
PLUGIN_DEBUG_MODE=false
PLUGIN_TIMEZONE=UTC

# Feature Toggles
PLUGIN_ENABLE_AUTHENTICATION=true
PLUGIN_ENABLE_REGISTRATION=false
PLUGIN_ENABLE_SSL=false
PLUGIN_ENABLE_METRICS=true

# Performance Settings
PLUGIN_MAX_CONNECTIONS=100
PLUGIN_WORKER_THREADS=4
PLUGIN_MEMORY_LIMIT=512M
PLUGIN_CPU_LIMIT=0.5
PLUGIN_MEMORY_RESERVE=128M

# Storage Configuration
PLUGIN_DATA_PATH=/app/data
PLUGIN_CONFIG_PATH=/app/config
PLUGIN_LOGS_PATH=/app/logs
PLUGIN_BACKUP_PATH=/app/backups

# External Services (if needed)
PLUGIN_SMTP_HOST=smtp.yourdomain.com
PLUGIN_SMTP_PORT=587
PLUGIN_SMTP_USER=noreply@yourdomain.com
PLUGIN_SMTP_PASSWORD=smtp-password
PLUGIN_SMTP_FROM=noreply@yourdomain.com

# API Configuration
PLUGIN_API_KEY=your-api-key-here
PLUGIN_API_SECRET=your-api-secret-here
PLUGIN_WEBHOOK_SECRET=webhook-secret-key

# Security Configuration
PLUGIN_SESSION_SECRET=long-random-session-secret
PLUGIN_JWT_SECRET=jwt-signing-secret
PLUGIN_ENCRYPTION_KEY=32-character-encryption-key

# Third-party Integrations
PLUGIN_OAUTH_CLIENT_ID=oauth-client-id
PLUGIN_OAUTH_CLIENT_SECRET=oauth-client-secret
PLUGIN_OAUTH_REDIRECT_URI=https://your-plugin.yourdomain.com/auth/callback

# Backup Configuration
PLUGIN_BACKUP_ENABLED=true
PLUGIN_BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
PLUGIN_BACKUP_RETENTION_DAYS=30
PLUGIN_BACKUP_COMPRESSION=true

# Monitoring and Alerting
PLUGIN_METRICS_ENABLED=true
PLUGIN_METRICS_PORT=9090
PLUGIN_HEALTH_CHECK_PATH=/health
PLUGIN_ALERT_EMAIL=alerts@yourdomain.com

# Development/Testing
PLUGIN_DEVELOPMENT_MODE=false
PLUGIN_TEST_DATA_ENABLED=false
PLUGIN_MOCK_EXTERNAL_SERVICES=false

# Custom Plugin Variables
# Add your plugin-specific variables below this line