# Ultimate Docker Business Server .gitignore

# Environment files
.env
.env.local
.env.production
.env.staging

# Secrets and sensitive data
secrets/
*.key
*.pem
*.p12
*.jks
config/traefik/dashboard-users
config/traefik/dynamic.yml

# Data directories (persistent storage)
data/
!data/.gitkeep

# SSL certificates and ACME data
acme.json
*.crt
*.cert
*.ca-bundle

# Docker volumes and temporary files
.docker/
docker-compose.override.yml

# Logs
logs/
*.log
*.log.*

# Backup files
backups/
*.backup
*.bak
*.sql.gz
*.tar.gz

# Setup state and runtime files
.setup_state
.install_lock
.maintenance_mode

# Plugin-specific ignores
plugins/enabled/*
!plugins/enabled/.gitkeep

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.vim/

# Node.js (for any frontend development)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (for any utility scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Database files
*.db
*.sqlite
*.sqlite3

# Monitoring and metrics
prometheus/
grafana/
alertmanager/

# Cache directories
.cache/
.npm/
.yarn/

# Local development overrides
docker-compose.dev.yml
docker-compose.local.yml
.env.dev
.env.local

# Test files
test-results/
coverage/
*.cover
.coverage
.pytest_cache/

# Documentation build files
docs/_build/
docs/.doctrees/

# IDE and editor specific
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
Session.vim

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp

# Archives
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.rar
*.7z

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Configuration overrides
config/local/
local.yml
local.yaml

# Plugin development
plugins/available/*/test/
plugins/available/*/tests/
plugins/available/*/.env

# Terraform (for infrastructure as code)
*.tfstate
*.tfstate.*
.terraform/
*.tfvars

# Ansible (for server management)
*.retry
.ansible/

# SSL certificate challenges
.well-known/

# Monitoring exports
*.prom
exports/

# Performance test results
performance/
benchmarks/

# Security scan results
security-reports/
vulnerability-scans/

# Maintenance scripts output
maintenance-logs/
update-logs/

# Custom user additions (add your own below this line)
# user-custom/